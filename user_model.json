{
  "title": "User model",
  "description": "User that loves bad horror movies",
  "fields": [
    {
      "id": "preferred_genre",
      "label": "Preferred genre",
      "type": "text",
      "default": "Horror Mystery",
      "include_in_retrieval": true,
      "item_fields": [
        "genres"
      ],
      "weight": 1.5,
      "matching": "token_overlap"
    },
    {
      "id": "loves_bad_movies",
      "label": "Low IMDB Score",
      "type": "number",
      "default": 10,
      "include_in_retrieval": false,
      "item_fields": [
        "imdb_score"
      ],
      "weight": 2,
      "matching": "prefer_smaller"
    }
  ]
}
